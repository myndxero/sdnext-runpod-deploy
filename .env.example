# =============================================================================
# SD.Next RunPod Deployment Suite (.env.example)
# Copy to .env or export variables before running ./deploy-sdnext.sh
# =============================================================================

# --- Core Workspace & WebUI ---
WORKSPACE_DIR=/workspace
PORT=7860
BACKEND=cuda
RUN_MODE=supervise
MODEL_PROFILE=core                  # minimal | core | flux | video | full
DOWNLOAD_RESOURCE_PACK=1            # 1 = 4x-UltraSharp, 4x-AnimeSharp, YOLOv8 face/hand/person, EasyNegative
GRADIO_AUTH=                        # e.g. admin:supersecret
API_AUTH=                           # e.g. admin:supersecret
WEBHOOK_URL=                        # Discord / Slack webhook URL for status & crash alerts

# --- Model & Asset Tokens / Custom URLs ---
HF_TOKEN=                           # HuggingFace token (for gated FLUX.1-dev / FLUX.3-klein)
CIVITAI_TOKEN=                      # CivitAI API token
MODEL_URLS=""                       # Space-separated URLs or subdir::url or civitai://VERSION_ID
LORA_URLS=""                        # Space-separated LoRA URLs or civitai://VERSION_ID
EMBEDDING_URLS=""                   # Space-separated Embedding URLs or civitai://VERSION_ID
UPSCALER_URLS=""                    # Space-separated Upscaler URLs
YOLO_URLS=""                        # Space-separated YOLOv8 Detailer URLs
WILDCARD_URLS=""                    # Space-separated Wildcard URLs

# --- Cost Protection & Real-Time Streaming ---
INSTANT_OUTPUT_SYNC=1               # 1 = stream new outputs via inotifywait within 4s
IDLE_SHUTDOWN_MINUTES=0             # e.g. 45 = auto-backup & stop pod after 45m of GPU < 3%

# --- Google Drive Integration ---
DRIVE_ENABLED=1
DRIVE_REMOTE=gdrive
DRIVE_ROOT=SDNext
DRIVE_MOUNT_MODE=sync               # sync | mount | hybrid
DRIVE_SYNC_MINUTES=15
RCLONE_CONFIG_B64=                  # base64 -w0 ~/.config/rclone/rclone.conf
GDRIVE_SERVICE_ACCOUNT_B64=         # Optional base64 service account JSON

# --- Phone Storage Integration (Android & iOS) ---
PHONE_ENABLED=0
PHONE_PROTOCOL=sftp                 # sftp | webdav | ftp
PHONE_HOST=                         # Tailscale IP (100.x.y.z) or LAN IP
PHONE_PORT=8022                     # 8022 (Termux sshd) | 8080 (WebDAV)
PHONE_USER=                         # e.g. u0_a245
PHONE_PASS=
PHONE_ROOT=/sdcard/SDNext
PHONE_MAX_PULL_GB=50
TAILSCALE_AUTH_KEY=                 # tskey-auth-... (for userspace Tailscale inside RunPod)
POD_WEBDAV_ENABLED=0                # 1 = expose Pod on port 7861 for iOS Files / Android mount
POD_WEBDAV_PORT=7861
POD_WEBDAV_USER=sdnext
POD_WEBDAV_PASS=
SYNCTHING_ENABLED=0                 # 1 = headless Syncthing P2P daemon
SYNCTHING_PHONE_ID=                 # 56-char Syncthing Device ID of your phone

# --- Front-End RunPod Provisioner ---
RUNPOD_API_KEY=                     # rp_...
GPU_TIER=auto                       # auto | 16gb | 24gb | 48gb | 80gb
MAX_USD_PER_HR=2.50
CLOUD_TYPE=ALL                      # SECURE | COMMUNITY | ALL
POD_NAME=sdnext-webui
POD_VOLUME_GB=100
NETWORK_VOLUME_ID=
DATACENTER_ID=
